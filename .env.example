NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Use a URL interna fornecida pelo serviço PostgreSQL do Easypanel.
DATABASE_URL=postgres://postgres:troque-a-senha@projeto_postgres:5432/campania_tse?sslmode=disable
DATABASE_SSL=false

# Gere segredos diferentes e longos. API_KEYS aceita rotação com valores separados por vírgula.
API_KEYS=troque-por-uma-chave-com-ao-menos-32-caracteres
ADMIN_API_KEY=troque-por-outra-chave-com-ao-menos-32-caracteres
CORS_ORIGINS=https://crm.newtonbonin.com.br

AUTO_SYNC_ENABLED=true
TSE_ENVIRONMENT=oficial
TSE_POLL_INTERVAL_SECONDS=5
TSE_REQUEST_TIMEOUT_SECONDS=15

# Produção: SQ, número e nome precisam corresponder ao mesmo registro oficial.
TSE_NEWTON_BONIN_SQ_CANDIDATO=160002540768
TSE_NEWTON_BONIN_NUMERO=1023

# Simulado: candidato fictício usado somente para validar o fluxo técnico.
TSE_SIMULADO_CANDIDATO_SQ_CANDIDATO=41645079
TSE_SIMULADO_CANDIDATO_NUMERO=9010
